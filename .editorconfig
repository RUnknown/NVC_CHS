root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# A `*prefix=` dictionary key may legitimately end with a space (for example
# "Download " or "Copying installer files "). Trimming it changes matching.
[*.txt]
trim_trailing_whitespace = false

# C# naming rules (Microsoft .editorconfig defaults + project convention).
[*.cs]
dotnet_naming_rule.interfaces_must_be_prefixed_with_i.severity = suggestion
dotnet_naming_rule.interfaces_must_be_prefixed_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_be_prefixed_with_i.style = prefix_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_rule.types_must_use_pascal_case.severity = suggestion
dotnet_naming_rule.types_must_use_pascal_case.symbols = types_and_namespaces
dotnet_naming_rule.types_must_use_pascal_case.style = pascal_case
dotnet_naming_symbols.types_and_namespaces.applicable_kinds = namespace, class, struct, enum, delegate

dotnet_naming_rule.non_field_members_must_use_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_must_use_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_must_use_pascal_case.style = pascal_case
dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method

# Project convention: private static readonly fields stay PascalCase
# (Roslyn / ASP.NET Core style); mutable private fields are _camelCase.
dotnet_naming_rule.private_static_readonly_fields_pascal_case.severity = suggestion
dotnet_naming_rule.private_static_readonly_fields_pascal_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_pascal_case.style = pascal_case
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_modifiers = static, readonly

dotnet_naming_rule.private_mutable_fields_underscore_camel_case.severity = suggestion
dotnet_naming_rule.private_mutable_fields_underscore_camel_case.symbols = private_mutable_fields
dotnet_naming_rule.private_mutable_fields_underscore_camel_case.style = underscore_camel_case
dotnet_naming_symbols.private_mutable_fields.applicable_kinds = field
dotnet_naming_symbols.private_mutable_fields.applicable_accessibilities = private

dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
